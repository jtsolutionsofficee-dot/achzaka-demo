{
  "name": "achzaka",
  "version": "1.0.0",
  "private": true,
  "description": "אחזקה — מערכת תפעול לקריאות שירות בבתים ובדירות יוקרה",
  "scripts": {
    "build": "vite build --config client/vite.config.mjs",
    "start": "node server/index.js",
    "dev": "npm run build && npm start",
    "start:demo": "DEMO_OTP=1 node server/index.js",
