# Production (Render sets most of these through render.yaml)
NODE_ENV=production
PORT=10000                      # Render injects PORT; locally the default is 4173
DATABASE_URL=postgresql://user:password@host:5432/achzaka
UPLOAD_DIR=/var/data/uploads    # Render Disk mount; locally defaults to data/uploads
PG_POOL_MAX=10
PGSSL=0                         # 1 only when connecting over the external (public) DB URL
DEMO_OTP=0                      # 1 = show login codes on screen (local demo only; ignored in production)
DEMO_DATA=0                     # 1 = seed demo data and reset the demo script on every start
ADMIN_PHONE=05XXXXXXXX          # first manager, created only when there are no users
ADMIN_PASSWORD=change-me-8+chars
ADMIN_NAME=מנהל
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Local demo without DATABASE_URL uses SQLite at data/achzaka.db (override with SQLITE_PATH)
SMTP_URL=
SMTP_FROM=
CHROME_PATH=                    # optional; default: .chrome/ headless shell, then /usr/bin/google-chrome
